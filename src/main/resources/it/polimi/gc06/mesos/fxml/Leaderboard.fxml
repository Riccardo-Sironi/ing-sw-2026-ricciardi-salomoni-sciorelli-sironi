<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootPane"
           prefHeight="1080.0" prefWidth="1920.0"
           style="-fx-background-color: black;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.gc06.mesos.view.gui.controllers.LeaderboardController">

    <ImageView fx:id="steleBackground" />

    <AnchorPane mouseTransparent="true" pickOnBounds="false" maxWidth="1920.0" maxHeight="1080.0">
        <ImageView fx:id="smokeGifView" />
        <ImageView fx:id="fireGifView" />
    </AnchorPane>

    <StackPane fx:id="elementsContainer" maxWidth="1920.0" maxHeight="1080.0">

        <ImageView fx:id="podiumImage" StackPane.alignment="CENTER" />

        <AnchorPane fx:id="totemsContainer" maxWidth="1920.0" maxHeight="1080.0" mouseTransparent="true" />

    </StackPane>

</StackPane>