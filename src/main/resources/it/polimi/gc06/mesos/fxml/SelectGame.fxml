<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane fx:id="rootPane"
           prefHeight="1080.0" prefWidth="1920.0"
           style="-fx-background-color: black;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.gc06.mesos.view.gui.controllers.SelectGameController">

    <!--    <fx:define>-->
    <!--        <fx:String fx:id="scrollPaneStyle" fx:value=".scroll-pane { -fx-background-color: transparent; } .scroll-pane .viewport { -fx-background-color: transparent; }" />-->
    <!--    </fx:define>-->

    <ImageView fx:id="backgroundImageView" opacity="0.8" />

    <ImageView fx:id="particlesImageView"
               mouseTransparent="true"
               blendMode="SCREEN"
               preserveRatio="true"
               StackPane.alignment="BOTTOM_CENTER" />

    <Region fx:id="bottomGlow"
            mouseTransparent="true"
            maxHeight="600.0"
            blendMode="ADD"
            StackPane.alignment="BOTTOM_CENTER"
            style="-fx-background-color:
                radial-gradient(
                center 50% 100%,
                radius 20%, rgba(255, 120, 0, 0.4),
                transparent);"
    />

    <VBox fx:id="mainBox"
          alignment="CENTER"
          spacing="30.0"
          maxWidth="1000.0"
          maxHeight="500.0"
          style="-fx-background-color: transparent;">

        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>

        <Label fx:id="titleLabel" text="AVAILABLE MATCHES" textFill="#2B2B2B">
            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>
        </Label>

        <ScrollPane fx:id="matchesScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="NEVER"
                    style="
                        -fx-background-color: transparent;
                        -fx-background: transparent;
                        -fx-control-inner-background: transparent;
                        -fx-border-color: transparent;">

            <VBox fx:id="matchesContainer" alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: transparent;">
                <padding>
                    <Insets top="10.0" bottom="10.0" left="20.0" right="20.0"/>
                </padding>
            </VBox>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="40.0">
            <Button fx:id="refreshButton" text="REFRESH" onAction="#handleRefresh" prefWidth="200.0" prefHeight="50.0" />
            <Button fx:id="createButton" text="CREATE MATCH" onAction="#showCreateOptions" prefWidth="250.0" prefHeight="50.0" />
        </HBox>

        <HBox fx:id="playersSelectionBox" alignment="CENTER" spacing="20.0" visible="false" managed="false">
            <Label fx:id="playersLabel" text="PLAYERS:" textFill="#2B2B2B">
                <effect>
                    <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
                </effect>
            </Label>
            <Button text="2" onAction="#handleCreateMatch" userData="2" prefWidth="60.0" prefHeight="50.0" />
            <Button text="3" onAction="#handleCreateMatch" userData="3" prefWidth="60.0" prefHeight="50.0" />
            <Button text="4" onAction="#handleCreateMatch" userData="4" prefWidth="60.0" prefHeight="50.0" />
            <Button text="5" onAction="#handleCreateMatch" userData="5" prefWidth="60.0" prefHeight="50.0" />
        </HBox>

    </VBox>
</StackPane>