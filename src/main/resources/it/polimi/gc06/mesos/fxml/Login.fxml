<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           prefHeight="1080.0" prefWidth="1920.0"
           style="-fx-background-color: black;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.gc06.mesos.view.gui.controllers.LoginController">

    <ImageView fx:id="backgroundImageView" opacity="0.8" />

    <ImageView fx:id="particlesImageView"
               mouseTransparent="true"
               blendMode="SCREEN"
               preserveRatio="true"
               StackPane.alignment="BOTTOM_CENTER" />

    <Region fx:id="bottomGlow"
            mouseTransparent="true"
            maxHeight="600.0"
            blendMode="ADD"
            StackPane.alignment="BOTTOM_CENTER"
            style="-fx-background-color:
                radial-gradient(
                center 50% 100%,
                radius 20%, rgba(255, 120, 0, 0.4),
                transparent);"
    />

    <VBox fx:id="loginBox"
          alignment="CENTER"
          spacing="20.0"
          maxWidth="1200.0"
          maxHeight="600.0"
          style="-fx-background-color: transparent;">

        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>

        <Label fx:id="promptLabel" text="INSERT YOUR TRIBE NAME" textFill="#2B2B2B" textAlignment="CENTER">
            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <TextField fx:id="nicknameField"
                   promptText="..."
                   style="
                        -fx-background-color: transparent;
                        -fx-border-color: transparent transparent #2B2B2B transparent;
                        -fx-border-width: 0 0 3 0;
                        -fx-text-fill: #2B2B2B;
                        -fx-prompt-text-fill: rgba(43,43,43,0.5);
                        -fx-alignment: center;">
            <VBox.margin>
                <Insets bottom="10.0" left="100.0" right="100.0" />
            </VBox.margin>
            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>
        </TextField>

        <Label fx:id="advancedSettingsLabel"
               text="ADVANCED SETTINGS"
               textFill="#2B2B2B"
               style="-fx-cursor: hand;">
            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>
        </Label>

        <Button fx:id="joinButton"
                defaultButton="true"
                mnemonicParsing="false"
                onAction="#handleLogin"
                prefWidth="250.0"
                prefHeight="60.0"
                text="SUBMIT"
                style="
                     -fx-background-color: transparent;
                     -fx-border-color: #2B2B2B;
                     -fx-border-width: 3;
                     -fx-text-fill: #2B2B2B;
                     -fx-background-radius: 10;
                     -fx-border-radius: 10;
                     -fx-cursor: hand;">

            <effect>
                <DropShadow fx:id="buttonShadow" color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="2.5" />
            </effect>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>

    </VBox>

    <StackPane fx:id="advancedSettingsOverlay"
               style="-fx-background-color: rgba(0,0,0,0.3);">

        <VBox fx:id="advancedSettingsModal"
              alignment="CENTER"
              spacing="40.0"
              maxWidth="500.0"
              maxHeight="550.0"
              style="-fx-background-color: #1a1a1a; -fx-border-color: #3a3a3a; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 20, 0, 0, 10);">

            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label fx:id="advancedSettingsTitle" text="CONNECTION SETTINGS" textFill="#E0E0E0" textAlignment="CENTER">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.6)" radius="2.0" spread="0.4" offsetY="1.5" />
                </effect>
            </Label>

            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="rmiButton" text="RMI" prefWidth="100.0" prefHeight="40.0" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Button fx:id="tcpButton" text="TCP" prefWidth="100.0" prefHeight="40.0" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>

            <VBox spacing="30.0" alignment="CENTER">
                <TextField fx:id="ipField"
                           promptText="IP (default: localhost)"
                           prefWidth="350.0"
                           style="
                                -fx-font-size: 18px;
                                -fx-background-color: transparent;
                                -fx-border-color: transparent transparent #E0E0E0 transparent;
                                -fx-border-width: 0 0 3 0;
                                -fx-text-fill: #E0E0E0;
                                -fx-prompt-text-fill: rgba(224,224,224,0.5);
                                -fx-alignment: center;">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.4)" radius="1.0" spread="0.2" offsetY="1.0" />
                    </effect>
                </TextField>

                <TextField fx:id="portField"
                           promptText="Port (default: 1099)"
                           prefWidth="350.0"
                           style="
                                -fx-font-size: 18px;
                                -fx-background-color: transparent;
                                -fx-border-color: transparent transparent #E0E0E0 transparent;
                                -fx-border-width: 0 0 3 0;
                                -fx-text-fill: #E0E0E0;
                                -fx-prompt-text-fill: rgba(224,224,224,0.5);
                                -fx-alignment: center;">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.4)" radius="1.0" spread="0.2" offsetY="1.0" />
                    </effect>
                </TextField>

                <ComboBox fx:id="networkInterfaceBox"
                          promptText="Select Network Interface"
                          prefWidth="350.0"
                          style="-fx-background-color: #2B2B2B;
                                 -fx-border-color: #E0E0E0;
                                 -fx-border-width: 2;
                                 -fx-text-fill: #E0E0E0;
                                 -fx-background-radius: 5;
                                 -fx-border-radius: 5;
                                 -fx-cursor: hand;">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.4)" radius="1.0" spread="0.2" offsetY="1.0" />
                    </effect>
                </ComboBox>
            </VBox>

            <Button fx:id="okButton"
                    mnemonicParsing="false"
                    onAction="#closeAdvancedSettings"
                    prefWidth="150.0"
                    prefHeight="50.0"
                    text="OK"
                    style="
                         -fx-font-size: 18px;
                         -fx-font-weight: bold;
                         -fx-background-color: transparent;
                         -fx-border-color: #E0E0E0;
                         -fx-border-width: 3;
                         -fx-text-fill: #E0E0E0;
                         -fx-background-radius: 10;
                         -fx-border-radius: 10;
                         -fx-cursor: hand;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.6)" radius="2.0" spread="0.2" offsetY="2.0" />
                </effect>
            </Button>

        </VBox>
    </StackPane>

</StackPane>