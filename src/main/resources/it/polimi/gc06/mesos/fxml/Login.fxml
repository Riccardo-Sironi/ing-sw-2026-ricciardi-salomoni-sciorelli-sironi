<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           prefHeight="1080.0" prefWidth="1920.0"
           style="-fx-background-color: black;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.gc06.mesos.view.gui.controllers.LoginController">

    <!-- Background Layers -->
    <ImageView fx:id="backgroundImageView" opacity="0.8" />

    <ImageView fx:id="particlesImageView"
               mouseTransparent="true"
               blendMode="SCREEN"
               preserveRatio="true"
               StackPane.alignment="BOTTOM_CENTER" />

    <Region fx:id="bottomGlow"
            mouseTransparent="true"
            maxHeight="600.0"
            blendMode="ADD"
            StackPane.alignment="BOTTOM_CENTER"
            style="-fx-background-color:
                radial-gradient(
                center 50% 100%,
                radius 20%, rgba(255, 120, 0, 0.4),
                transparent);"
    />

    <!-- Login Content -->
    <VBox fx:id="loginBox"
          alignment="CENTER"
          spacing="30.0"
          maxWidth="1200.0"
          maxHeight="500.0"
          style="-fx-background-color: transparent;">

        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>

        <Label fx:id="promptLabel" text="INSERT YOUR TRIBE NAME" textFill="#2B2B2B" textAlignment="CENTER">

            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>

        </Label>

        <TextField fx:id="nicknameField"
                   promptText="..."
                   style="
                        -fx-background-color: transparent;
                        -fx-border-color: transparent transparent #2B2B2B transparent;
                        -fx-border-width: 0 0 3 0;
                        -fx-text-fill: #2B2B2B;
                        -fx-prompt-text-fill: rgba(43,43,43,0.5);
                        -fx-alignment: center;">

            <VBox.margin>
                <Insets bottom="20.0" left="100.0" right="100.0" />
            </VBox.margin>

            <effect>
                <DropShadow color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="1.5" />
            </effect>

        </TextField>

        <Button fx:id="joinButton"
                defaultButton="true"
                mnemonicParsing="false"
                onAction="#handleLogin"
                prefWidth="250.0"
                prefHeight="60.0"
                text="SUBMIT"
                style="
                     -fx-background-color: transparent;
                     -fx-border-color: #2B2B2B;
                     -fx-border-width: 3;
                     -fx-text-fill: #2B2B2B;
                     -fx-background-radius: 10;
                     -fx-border-radius: 10;
                     -fx-cursor: hand;">

            <effect>
                <DropShadow fx:id="buttonShadow" color="rgba(255,255,255,0.4)" radius="1.0" spread="0.8" offsetY="2.5" />
            </effect>

        </Button>

    </VBox>

</StackPane>